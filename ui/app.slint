import { Card } from "card.slint";
import { Button } from "button.slint";
import { UpdateBlocking } from "pages/update-blocking.slint";
import { BatteryHealth } from "pages/battery-health.slint";
import { EnvironmentUpdate } from "pages/environment-update.slint";
import { Background } from "background.slint";
import { SSHUsbNet } from "pages/ssh-usb-net.slint";
import { RecoveryManagement } from "pages/recovery-management.slint";

/*
    This project scales relative to root.height, 
    so long as all proportions remain sensible in a portrait position as well as as a square one (Oasis).
*/

export component AppWindow inherits Window {
    background: white;

    in property <bool> boot-mode: false;
    in property <string> usb-ssh-ip: "N/A";
    in property <string> wifi-ssh-ip: "N/A";
    in property <string> boot-reason: "N/A";
    in property <string> jobman-version: "1.0.0";
    in property <bool> ota-status: false;
    in property <bool> wifi-status: false;
    in property <bool> usb-ssh-status: false;
    in property <bool> wifi-ssh-status: false;
    in property <int> battery-health: -1;
    in property <bool> recovery-installation-status: false;
    in property <string> ssh-password: "N/A";
    private property <bool> updating-env: false; //Terminates GUI upon completion
    private property <bool> ota-renaming: false; //^Same
    private property <string> view: "home";
    in-out property <bool> show-error: false;
    in-out property <string> error: "An unknown error occurred. Please retry at another time.";

    in property <bool> koreader-status: false;
    in-out property <bool> recovery-generating-logs: false; //The only reason this buttons has progress indicators/blocking is because it has intensive FS operations, can take a while.
    private property <bool> recovery-opening-koreader: false; //If opened, GUI terminates anyway, does not need an external update.
    callback recovery_generate_logs();
    callback create_koreader_flag();

    callback quit();
    callback toggle_ota();
    callback update_environment();
    callback usb_ssh_toggle();
    callback wifi_ssh_toggle();
    callback recovery_toggle();

    Background {}

    //Header content
    Rectangle {
        x: root.width - self.width - root.width * 0.03;
        y: root.height * 0.02;
        width: root.width * 0.1;
        height: root.width * 0.1;
        border-width: root.width * 0.005;
        border-color: black;
        border-radius: root.width * 0.015;
        background: quit-touch.pressed ? #cccccc : white;

        quit-touch := TouchArea {
            clicked => { 
                if view == "home" { root.quit(); }
                if view != "home" { root.view = "home" } 
            }
        }

        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                alignment: center;
                if view == "home": Text {
                    text: "×";
                    font-size: root.width * 0.07;
                    font-family: "Libre Baskerville"; //Inter ruins centering.
                    color: black;
                    font-weight: 800; 
                }

                if view != "home": Text {
                    text: "←";
                    font-family: "Libre Baskerville";
                    font-size: root.width * 0.06;
                    color: black;
                }
            }
        }
    }

    if view != "home": StyledText {
        x: root.width * 0.05;
        y: root.height * 0.035;
        width: self.preferred-width;
        horizontal-alignment: left;
        text: @markdown("<u>\{view}</u>");
        default-font-family: "Libre Baskerville";
        default-font-size: root.width * 0.06;
        default-color: black;
    }

    if view == "home": VerticalLayout {
        height: root.height * 0.05;
        y: root.height * 0.12;
        alignment: center;
        spacing: root.height * 0.015; 

        Text {
            x: 0;
            width: parent.width;
            text: "Jobman";
            font-size: root.width * 0.15;
            font-family: "Libre Baskerville";
            color: black;
            horizontal-alignment: center;
        }

        Text {
            x: 0;
            width: parent.width;
            text: root.boot-mode ? "Your Friendly Recovery Menu" : "Your Friendly Jailbreaking Manager";
            font-family: "Inter";
            font-size: root.width * 0.04;
            color: black;
            horizontal-alignment: center;
        }
    }

    //Main content
    Rectangle {
        x: root.width * 0.05;
        y: root.height * 0.37;
        width: root.width * 0.9;
        height: root.height - self.y - (root.height * 0.25);

        if view == "home": VerticalLayout {
            y: 0;
            spacing: root.height * 0.01; 

            if !root.boot-mode: Card {
               root-height: root.height;
               title: "Update Blocking";
               description: "Manage the enabling & disabling of OTA binaries";
               clicked => { root.view = "Update Blocking" }
            }

            Card {
                root-height: root.height;
                title: "SSH & USB Networking";
                description: root.boot-mode ? "Start an emergency SSH over USB server" : "Start an SSH server over USB or Wi-Fi";
                clicked => { root.view = "SSH & USB Networking" }
            }
            
            if root.boot-mode: Card {
                root-height: root.height;
                title: root.recovery-generating-logs ? "Generating Logs..." : "Generate Logs";
                description: "Generate multiple logs of previous boot attempts";
                disabled: root.recovery-generating-logs;
                clicked => {
                    root.recovery-generating-logs = true;
                    recovery_generate_logs();
                }
            }

            if root.boot-mode: Card {
                root-height: root.height;
                title: root.recovery-opening-koreader ? "Opening KOReader..." : (root.koreader-status ? "Open KOReader" : "KOReader Not Installed!");
                description: "KOReader is a document viewer for E-Ink devices.";
                disabled: !root.koreader-status || root.recovery-opening-koreader;
                clicked => {
                    root.recovery-opening-koreader = true;
                    create_koreader_flag();
                }
            }

            if root.boot-mode: Image {
                source: @image-url("bee.png");
                width: 100%;
                height: root.height * 0.2;
                image-fit: contain;
            }

            if !root.boot-mode: Card {
               root-height: root.height;
               title: "Environment Update";
               description: "Update the jailbreaking environment";
               clicked => { root.view = "Environment Update" }
            }

            if !root.boot-mode: Card {
               root-height: root.height;
               title: "Battery Health";
               description: "Automatic battery checking utility";
               clicked => { root.view = "Battery Health" }
            }

            if !root.boot-mode: Card {
               root-height: root.height;
               title: "Recovery Management";
               description: "Toggle the experimental Jobman recovery system";
               clicked => { root.view = "Recovery Management" }
            }
        }

        if view == "Update Blocking": UpdateBlocking {
            root-height: root.height;
            ota-status: root.ota-status;
            ota-renaming <=> root.ota-renaming;
            toggle-ota => {
                root.toggle_ota();
            }
        }

        if view == "SSH & USB Networking": SSHUsbNet {
            root-height: root.height;
            usb-ssh-ip: root.usb-ssh-ip;
            wifi-ssh-ip: root.wifi-ssh-ip;
            usb-ssh-status: root.usb-ssh-status;
            wifi-ssh-status: root.wifi-ssh-status;
            boot-mode: root.boot-mode;
            wifi-status: root.wifi-status;
            ssh-password: root.ssh-password;
            usb-ssh-toggle => {
                root.usb_ssh_toggle();
            }
            wifi-ssh-toggle => {
                root.wifi_ssh_toggle();
            }
        }

        if view == "Environment Update": EnvironmentUpdate {
            root-height: root.height;
            wifi-status: root.wifi-status;
            updating-env <=> root.updating-env;
            update-environment => {
                root.update_environment();
            }
        }

        if view == "Battery Health": BatteryHealth {
            root-height: root.height;
            battery-health: root.battery-health;
        }

        if view == "Recovery Management": RecoveryManagement {
            root-height: root.height;
            recovery-installation-status: root.recovery-installation-status;
            recovery-toggle => {
                root.recovery_toggle();
            }
        }
    }

    Text {
        x: 0;
        y: root.boot-mode ? root.height * 0.9 : root.height * 0.95;
        width: parent.width;
        text: root.boot-mode ? "Reason: " + root.boot-reason + "\nhttps://kindlemodding.org/recovery\nMade by KindleTweaks | v" + root.jobman-version : "Made by KindleTweaks | v" + root.jobman-version;
        font-size: root.width * 0.03;
        color: #4b5563;
        horizontal-alignment: center;
    }
    
    //Error Dialog
    if root.show-error: TouchArea {
        clicked => {}

        Rectangle {
            background: #000000aa; 
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    background: white;
                    border-radius: root.width * 0.05;
                    width: root.width * 0.8;
                    border-width: root.width * 0.005;
                    border-color: black;

                    VerticalLayout {
                        padding: root.width * 0.08;
                        spacing: root.height * 0.05;

                        Text {
                            text: "Error Occurred";
                            font-family: "Libre Baskerville";
                            font-size: root.width * 0.07;
                            color: black;
                        }

                        Text {
                            text: root.error;
                            font-family: "Inter";
                            color: black;
                            font-size: root.width * 0.03;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }

                        Button {
                            root-height: root.height;
                            text: "Dismiss";
                            clicked => {
                                root.show-error = false;
                                root.ota-renaming = false; 
                                root.updating-env = false;
                                root.recovery-opening-koreader = false;
                            }
                        }
                    }
                }
            }   
        }
    }
}