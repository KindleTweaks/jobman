import { Button } from "../button.slint";
import { Page } from "../page.slint";

export component SSHUsbNet inherits Page {
    in property <string> usb-ssh-ip: "N/A";
    in property <string> wifi-ssh-ip: "N/A";
    in property <string> ssh-password: "N/A";
    private property <string> connection-mode: root.usb-ssh-status ? "USB" : (root.wifi-ssh-status ? "Wi-Fi" : "N/A (select mode)");
    in property <bool> usb-ssh-status: false;
    in property <bool> wifi-ssh-status: false;
    in property <bool> boot-mode: false;
    in property <bool> wifi-status: false;

    callback usb-ssh-toggle();
    callback wifi-ssh-toggle();

    VerticalLayout {
        alignment: center;
        spacing: root.root-height * 0.02;

        StyledText {
            default-color: black;
            width: 100%;
            default-font-size: root.root-height * 0.027;
            default-font-family: "Inter";
            horizontal-alignment: center;
            vertical-alignment: center;
            text: (root.usb-ssh-status || root.wifi-ssh-status)
            ? @markdown("SSH networking is currently **enabled!**")
            : @markdown("SSH networking is currently **disabled.**");
        }

        HorizontalLayout {
            alignment: center;

            VerticalLayout {
                spacing: root.root-height * 0.02;

                if root.wifi-ssh-status == false: Button {
                    root-height: root.root-height;
                    text: root.usb-ssh-status ? "Disable USB SSH" : "Enable USB SSH";
                    width: root.root-height * 0.5;
                    clicked => { 
                        usb-ssh-toggle();
                    }
                }

                if root.usb-ssh-status == false: Button {
                    root-height: root.root-height;
                    text: root.wifi-status || !root.boot-mode ? (root.wifi-ssh-status ? "Disable Wi-Fi SSH" : "Enable Wi-Fi SSH") : "Wi-Fi is Disabled!";
                    disabled: !root.wifi-status || root.boot-mode;
                    width: root.root-height * 0.5;
                    clicked => {
                        wifi-ssh-toggle();
                    }
                }
            }
        }

        Text {
            text: "IP: " + (!root.usb-ssh-status && !root.wifi-ssh-status ? "N/A (select mode)" : (root.usb-ssh-status ? root.usb-ssh-ip : root.wifi-ssh-ip)) 
            + "\nMode: " + root.connection-mode
            + "\nPassword: " + root.ssh-password 
            + "\nConfig is mandated in ~/jobman/ssh/etc/config.toml";
            color: #4b5563;
            wrap: word-wrap;
            width: 100%;
            font-size: root.width * 0.03;
            font-family: "Inter";
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
