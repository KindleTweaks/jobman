import { Button } from "../button.slint";
import { Page } from "../page.slint";

export component UpdateBlocking inherits Page {
    in-out property <bool> ota-renaming: false;
    in property <bool> ota-status: false;

    callback toggle-ota();

    layout := VerticalLayout {
        alignment: center;
        spacing: root.root-height * 0.02;

        StyledText {
            default-color: black;
            width: 100%;
            default-font-size: root.root-height * 0.027;
            default-font-family: "Inter";
            horizontal-alignment: center;
            vertical-alignment: center;
            text: root.ota-renaming ? @markdown("Please wait...") : (root.ota-status
                ? @markdown("OTA updates are currently **enabled**.")
                : @markdown("OTA updates are currently **disabled**."));
        }

        HorizontalLayout {
            alignment: center;

            Button {
                root-height: root.root-height;
                text: root.ota-status ? "Disable OTA Updates" : "Enable OTA Updates";
                width: root.root-height * 0.5;
                disabled: root.ota-renaming;
                clicked => {
                    root.ota-renaming = true;
                    root.toggle-ota();
                }
            }
        }

        Text {
            text: root.ota-status ? "This will keep your device safe from the possibility of Amazon updates." : "Warning! This will reboot your device, and enable the possibility of Amazon updates.";
            color: #4b5563;
            wrap: word-wrap;
            width: 100%;
            font-size: root.width * 0.03;
            font-family: "Inter";
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
